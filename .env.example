# ==============================================================================
# IncidentIQ (AgentOps) Environment Configuration Template
# Duplicate this file as '.env' and populate with your local/cloud credentials.
# ==============================================================================

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/agentops_db
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JWT Security
# 64-character hex key used to sign and verify stateless HS256 JWT tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# AI Provider Configuration (Options: 'groq' or 'gemini')
AI_PROVIDER=groq

# Groq API Configuration (Fast sub-second inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (Alternative LLM provider)
GEMINI_API_KEY=your_gemini_api_key_here
